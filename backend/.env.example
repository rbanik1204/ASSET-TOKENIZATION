# ═══════════════════════════════════════════════════════════════════════════
# AssetLinked Backend — Example Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env — only .env.example is tracked in git.
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3001
API_PREFIX=api
API_VERSION=v1

ALGORAND_NETWORK=testnet
ALGORAND_ALGOD_URL=https://testnet-api.algonode.cloud
ALGORAND_ALGOD_TOKEN=
ALGORAND_ALGOD_PORT=443
ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud
ALGORAND_INDEXER_TOKEN=
ALGORAND_INDEXER_PORT=443

ADMIN_ALGORAND_MNEMONIC=
ADMIN_ALGORAND_ADDRESS=

VERIFICATION_APP_ID=
INCOME_APP_ID=
GOVERNANCE_APP_ID=

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=assetlinked
DB_SYNCHRONIZE=true
DB_LOGGING=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

IPFS_PROVIDER=pinata
PINATA_API_KEY=
PINATA_SECRET_KEY=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

JWT_SECRET=change-me
JWT_EXPIRATION=86400

THROTTLE_TTL=60
THROTTLE_LIMIT=100

CORS_ORIGIN=http://localhost:5173
